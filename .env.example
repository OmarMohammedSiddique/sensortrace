# Copy to .env and edit. Docker Compose reads this file automatically.
# Never commit .env. Generate secrets with:  openssl rand -base64 48

# --- required in production -------------------------------------------------
# development | production
ST_ENVIRONMENT=development
# at least 32 random characters; signs file-access tokens
ST_SECRET_KEY=
# change in production
POSTGRES_PASSWORD=sensortrace
# object store credentials; change in production
S3_ACCESS_KEY=sensortrace
S3_SECRET_KEY=sensortrace-dev-secret
# must be true in production (HTTPS only)
ST_COOKIE_SECURE=false

# --- optional ---------------------------------------------------------------
# set false after creating your accounts
ST_ALLOW_REGISTRATION=true
WEB_PORT=3100
API_PORT=8100
DB_PORT=54329
REDIS_PORT=63799
S3_PORT=9100
# container limits for the image-processing worker
WORKER_MEM_LIMIT=6g
WORKER_CPUS=4
# per-job address-space cap inside the worker, in MB (0 = off)
ST_WORKER_MEMORY_LIMIT_MB=0
# sign-in/registration attempts per source address and per account in 15 minutes
ST_RATE_AUTH_PER_15MIN=60
# true only behind a reverse proxy that overwrites X-Forwarded-For (see SECURITY.md)
ST_TRUST_FORWARDED_FOR=false
# days before source addresses are cleared from audit records and ownerless failed sign-ins removed (0 = keep)
ST_AUDIT_ADDRESS_RETENTION_DAYS=90
